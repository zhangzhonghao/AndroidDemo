<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Minimal Light Theme using Material Design 3 -->
    <style name="Theme.AndroidDemo" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        
        <!-- Background and surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        
        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        
        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Flat buttons - no elevation -->
        <item name="materialButtonStyle">@style/Widget.AndroidDemo.Button.Flat</item>
        
        <!-- Card style - minimal elevation -->
        <item name="materialCardViewStyle">@style/Widget.AndroidDemo.CardView</item>
    </style>
    
    <!-- Flat button style - minimal, no shadow -->
    <style name="Widget.AndroidDemo.Button.Flat" parent="Widget.Material3.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- Outlined button style -->
    <style name="Widget.AndroidDemo.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- Text button style -->
    <style name="Widget.AndroidDemo.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- Minimal card style - light border instead of shadow -->
    <style name="Widget.AndroidDemo.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
    
    <!-- Bottom Navigation style -->
    <style name="Widget.AndroidDemo.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
    </style>
</resources>
