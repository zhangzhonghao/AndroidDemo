<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A1A">

    <!-- 显示屏区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="end|bottom">

        <!-- 历史表达式 -->
        <TextView
            android:id="@+id/tv_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="18sp"
            android:textColor="#888888"
            android:maxLines="1"
            android:ellipsize="start" />

        <!-- 当前表达式 -->
        <TextView
            android:id="@+id/tv_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textSize="36sp"
            android:textColor="@android:color/white"
            android:maxLines="2"
            android:ellipsize="start" />

        <!-- 计算结果 -->
        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textSize="24sp"
            android:textColor="#4CAF50"
            android:maxLines="1"
            android:ellipsize="start" />

    </LinearLayout>

    <!-- 按钮网格区域 -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:rowCount="5"
        android:columnCount="4"
        android:padding="8dp"
        android:useDefaultMargins="true">

        <!-- 第一行: C CE ( ) ÷ -->
        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="0"
            android:layout_row="0"
            android:text="C"
            android:textSize="24sp"
            android:textColor="#FF5722"
            android:background="@drawable/calculator_button_operator"
            android:onClick="onClearClick" />

        <Button
            android:id="@+id/btn_clear_entry"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="1"
            android:layout_row="0"
            android:text="CE"
            android:textSize="20sp"
            android:textColor="#FF5722"
            android:background="@drawable/calculator_button_operator"
            android:onClick="onClearEntryClick" />

        <Button
            android:id="@+id/btn_left_paren"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="2"
            android:layout_row="0"
            android:text="("
            android:textSize="24sp"
            android:textColor="#FF9800"
            android:background="@drawable/calculator_button_operator" />

        <Button
            android:id="@+id/btn_right_paren"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="3"
            android:layout_row="0"
            android:text=")"
            android:textSize="24sp"
            android:textColor="#FF9800"
            android:background="@drawable/calculator_button_operator" />

        <!-- 第二行: 7 8 9 ÷ -->
        <Button
            android:id="@+id/btn_7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="0"
            android:layout_row="1"
            android:text="7"
            android:textSize="24sp"
            android:textColor="#2196F3"
            android:background="@drawable/calculator_button_number" />

        <Button
            android:id="@+id/btn_8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="1"
            android:layout_row="1"
            android:text="8"
            android:textSize="24sp"
            android:textColor="#2196F3"
            android:background="@drawable/calculator_button_number" />

        <Button
            android:id="@+id/btn_9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="2"
            android:layout_row="1"
            android:text="9"
            android:textSize="24sp"
            android:textColor="#2196F3"
            android:background="@drawable/calculator_button_number" />

        <Button
            android:id="@+id/btn_divide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="3"
            android:layout_row="1"
            android:text="÷"
            android:textSize="28sp"
            android:textColor="#FF9800"
            android:background="@drawable/calculator_button_operator" />

        <!-- 第三行: 4 5 6 × -->
        <Button
            android:id="@+id/btn_4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="0"
            android:layout_row="2"
            android:text="4"
            android:textSize="24sp"
            android:textColor="#2196F3"
            android:background="@drawable/calculator_button_number" />

        <Button
            android:id="@+id/btn_5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="1"
            android:layout_row="2"
            android:text="5"
            android:textSize="24sp"
            android:textColor="#2196F3"
            android:background="@drawable/calculator_button_number" />

        <Button
            android:id="@+id/btn_6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="2"
            android:layout_row="2"
            android:text="6"
            android:textSize="24sp"
            android:textColor="#2196F3"
            android:background="@drawable/calculator_button_number" />

        <Button
            android:id="@+id/btn_multiply"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="3"
            android:layout_row="2"
            android:text="×"
            android:textSize="28sp"
            android:textColor="#FF9800"
            android:background="@drawable/calculator_button_operator" />

        <!-- 第四行: 1 2 3 - -->
        <Button
            android:id="@+id/btn_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="0"
            android:layout_row="3"
            android:text="1"
            android:textSize="24sp"
            android:textColor="#2196F3"
            android:background="@drawable/calculator_button_number" />

        <Button
            android:id="@+id/btn_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="1"
            android:layout_row="3"
            android:text="2"
            android:textSize="24sp"
            android:textColor="#2196F3"
            android:background="@drawable/calculator_button_number" />

        <Button
            android:id="@+id/btn_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="2"
            android:layout_row="3"
            android:text="3"
            android:textSize="24sp"
            android:textColor="#2196F3"
            android:background="@drawable/calculator_button_number" />

        <Button
            android:id="@+id/btn_subtract"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="3"
            android:layout_row="3"
            android:text="-"
            android:textSize="28sp"
            android:textColor="#FF9800"
            android:background="@drawable/calculator_button_operator" />

        <!-- 第五行: +/- 0 . + -->
        <Button
            android:id="@+id/btn_negate"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="0"
            android:layout_row="4"
            android:text="±"
            android:textSize="24sp"
            android:textColor="#FF9800"
            android:background="@drawable/calculator_button_operator" />

        <Button
            android:id="@+id/btn_0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="1"
            android:layout_row="4"
            android:text="0"
            android:textSize="24sp"
            android:textColor="#2196F3"
            android:background="@drawable/calculator_button_number" />

        <Button
            android:id="@+id/btn_decimal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="2"
            android:layout_row="4"
            android:text="."
            android:textSize="28sp"
            android:textColor="#FF9800"
            android:background="@drawable/calculator_button_operator" />

        <Button
            android:id="@+id/btn_add"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="3"
            android:layout_row="4"
            android:text="+"
            android:textSize="28sp"
            android:textColor="#FF9800"
            android:background="@drawable/calculator_button_operator" />

    </GridLayout>

    <!-- 等号按钮单独放在底部 -->
    <Button
        android:id="@+id/btn_equals"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="8dp"
        android:text="="
        android:textSize="32sp"
        android:textColor="@android:color/white"
        android:background="@drawable/calculator_button_equals" />

</LinearLayout>