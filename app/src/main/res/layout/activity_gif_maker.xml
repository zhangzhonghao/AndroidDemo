<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GIF制作器"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:paddingBottom="16dp" />

        <!-- 图片选择按钮 -->
        <Button
            android:id="@+id/btn_select_images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="从相册选择多张图片"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_capture_images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="拍照获取图片"
            android:layout_marginBottom="16dp" />

        <!-- 已选图片预览 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="已选图片"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tv_image_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="共 0 张图片"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/iv_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/surface_variant" />

        </androidx.cardview.widget.CardView>

        <!-- 图片列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_images"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp" />

        <!-- GIF参数设置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GIF参数设置"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <!-- 帧率设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="帧率 (fps):"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekbar_fps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="20"
                android:progress="10" />

            <TextView
                android:id="@+id/tv_fps_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="10"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- 尺寸设置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="输出尺寸"
            android:textSize="14sp"
            android:paddingTop="4dp" />

        <RadioGroup
            android:id="@+id/rg_gif_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <RadioButton
                android:id="@+id/rb_size_original"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="原始"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_size_75"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="75%" />

            <RadioButton
                android:id="@+id/rb_size_50"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="50%" />

            <RadioButton
                android:id="@+id/rb_size_25"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="25%" />

        </RadioGroup>

        <!-- 质量设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="质量:"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekbar_quality"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="20"
                android:progress="10" />

            <TextView
                android:id="@+id/tv_quality_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="中"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- 每帧持续时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="每帧时长:"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekbar_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="20"
                android:progress="10" />

            <TextView
                android:id="@+id/tv_duration_value"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="100ms"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- 预估信息 -->
        <TextView
            android:id="@+id/tv_gif_estimate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="预估大小: --  帧数: 0"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            android:paddingBottom="16dp" />

        <!-- GIF预览 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GIF预览"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_gif_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/surface_variant" />

        </androidx.cardview.widget.CardView>

        <!-- 进度条 -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_preview_gif"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="预览GIF"
                android:enabled="false"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_create_gif"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="生成GIF"
                android:enabled="false"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>