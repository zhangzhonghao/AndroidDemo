<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 标题栏 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WiFi 密码查看器"
        android:textSize="20sp"
        android:textColor="@color/on_surface"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/surface" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 提示信息 -->
            <TextView
                android:id="@+id/tv_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="需要 ROOT 权限才能查看 WiFi 密码"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:padding="12dp"
                android:background="@color/surface_variant"
                android:layout_marginBottom="16dp" />

            <!-- WiFi 状态 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前状态:"
                    android:textSize="16sp"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/tv_wifi_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未连接"
                    android:textSize="16sp"
                    android:textColor="@color/secondary"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- 网络名称 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="网络名称 (SSID)"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_ssid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="18sp"
                android:textColor="@color/on_surface"
                android:padding="12dp"
                android:background="@color/surface"
                android:layout_marginBottom="12dp" />

            <!-- BSSID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BSSID"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_bssid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                android:padding="12dp"
                android:background="@color/surface"
                android:layout_marginBottom="12dp" />

            <!-- 信号强度 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="信号强度"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_signal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="16sp"
                android:textColor="@color/on_surface"
                android:padding="12dp"
                android:background="@color/surface"
                android:layout_marginBottom="12dp" />

            <!-- 密码 (需要ROOT) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi 密码"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="需要 ROOT 权限"
                    android:textSize="18sp"
                    android:textColor="@color/error"
                    android:padding="12dp"
                    android:background="@color/surface"
                    android:fontFamily="monospace" />

                <ImageButton
                    android:id="@+id/btn_copy"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_save"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="复制密码"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 刷新按钮 -->
            <Button
                android:id="@+id/btn_refresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="刷新 WiFi 信息"
                android:textSize="16sp"
                android:padding="12dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>