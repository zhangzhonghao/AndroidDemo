<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="效率"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_background">

            <Button
                android:id="@+id/btn_pomodoro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="番茄钟"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_stopwatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="秒表"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_speed_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="网速测试"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_video_to_gif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="视频转GIF"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_watermark_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="水印相机"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="倒计时"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_countdown_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="倒计时天数"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_anniversary_manager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="纪念日管理"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_flash_sale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="秒杀"
                android:onClick="onFeatureClick" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
