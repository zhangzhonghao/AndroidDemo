<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 标题栏 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="农历日历"
        android:textSize="20sp"
        android:textColor="@color/on_background"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/surface" />

    <!-- 日期导航 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="@color/surface_variant">

        <Button
            android:id="@+id/btn_prev_day"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="&lt;"
            android:textSize="18sp"
            android:background="@drawable/circle_button_background"
            android:layout_marginEnd="24dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_solar_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024年1月1日"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/tv_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="星期一"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_next_day"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="&gt;"
            android:textSize="18sp"
            android:background="@drawable/circle_button_background"
            android:layout_marginStart="24dp" />

    </LinearLayout>

    <!-- 农历日期显示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/surface">

        <TextView
            android:id="@+id/tv_lunar_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="农历年份"
            android:textSize="16sp"
            android:textColor="@color/on_surface_variant"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tv_lunar_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="腊月初一"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_zodiac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="属鼠"
            android:textSize="16sp"
            android:textColor="@color/on_surface_variant"
            android:layout_gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- 二十四节气 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="8dp"
        android:background="@color/surface">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="二十四节气"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="12dp" />

        <GridLayout
            android:id="@+id/solar_terms_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="6"
            android:alignmentMode="alignBounds" />

    </LinearLayout>

    <!-- 传统节日 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="8dp"
        android:background="@color/surface">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="传统节日"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_festivals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>