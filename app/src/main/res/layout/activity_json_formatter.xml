<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JSON格式化" android:textSize="20sp" android:textStyle="bold" android:paddingBottom="16dp"/>
    <EditText android:id="@+id/et_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="输入JSON内容" android:minLines="5" android:gravity="top"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btn_format" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="格式化" android:onClick="format"/>
        <Button android:id="@+id/btn_compress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="压缩" android:onClick="compress"/>
        <Button android:id="@+id/btn_validate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="验证" android:onClick="validate"/>
    </LinearLayout>
    <TextView android:id="@+id/tv_output" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:layout_marginTop="16dp"/>
</LinearLayout>