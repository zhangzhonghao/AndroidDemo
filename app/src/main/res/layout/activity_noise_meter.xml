<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A252F"
    android:gravity="center_horizontal">

    <!-- 顶部当前分贝显示区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="30dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tv_current_db"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="72sp"
            android:textStyle="bold"
            android:textColor="#2ECC71" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="dB"
            android:textSize="24sp"
            android:textColor="#7F8C8D" />

        <TextView
            android:id="@+id/tv_db_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="安静"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2ECC71" />

    </LinearLayout>

    <!-- 波形显示区域 -->
    <com.example.androiddemo.tools.NoiseMeterView
        android:id="@+id/noise_meter_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="20dp" />

    <!-- 历史统计区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_max_db"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="最高: -- dB"
            android:textSize="14sp"
            android:textColor="#E74C3C"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_min_db"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="最低: -- dB"
            android:textSize="14sp"
            android:textColor="#3498DB"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_avg_db"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="平均: -- dB"
            android:textSize="14sp"
            android:textColor="#F1C40F"
            android:gravity="center" />

    </LinearLayout>

    <!-- 底部控制区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="40dp">

        <!-- 校准按钮 -->
        <Button
            android:id="@+id/btn_calibrate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="校准"
            android:textSize="16sp"
            android:onClick="onCalibrateClick"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- 间隔 -->
        <View
            android:layout_width="40dp"
            android:layout_height="1dp" />

        <!-- 重置按钮 -->
        <Button
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="重置"
            android:textSize="16sp"
            android:onClick="onResetClick"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

</LinearLayout>