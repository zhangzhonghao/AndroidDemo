<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="睡眠时长（小时）"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/et_sleep_hour"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_edit_text"
            android:gravity="center"
            android:hint="请输入睡眠时长（如：7.5）"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="夜间醒来次数"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/et_wake_count"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_edit_text"
            android:gravity="center"
            android:hint="夜间醒来次数（0表示一觉到天亮）"
            android:inputType="number"
            android:textSize="18sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="早晨醒来感觉（1-10分）"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/et_feel_level"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_edit_text"
            android:gravity="center"
            android:hint="感觉越好分数越高（1-10）"
            android:inputType="number"
            android:textSize="18sp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_analyze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="分析睡眠质量"
            android:layout_marginTop="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <TextView
                android:id="@+id/tv_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:text=""
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>