<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A252F"
    android:gravity="center_horizontal">

    <!-- 顶部当前音量显示区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="30dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tv_current_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="72sp"
            android:textStyle="bold"
            android:textColor="#2ECC71" />

        <TextView
            android:id="@+id/tv_volume_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/ 15"
            android:textSize="24sp"
            android:textColor="#7F8C8D" />

        <TextView
            android:id="@+id/tv_volume_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="--%"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2ECC71" />

    </LinearLayout>

    <!-- 音量条显示区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <!-- 音量进度条 -->
        <SeekBar
            android:id="@+id/seekbar_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="15"
            android:progress="0"
            android:progressTint="#2ECC71"
            android:thumbTint="#2ECC71" />

        <!-- 音量图标 -->
        <ImageView
            android:id="@+id/iv_volume_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:tint="#2ECC71" />

        <!-- 音量状态文字 -->
        <TextView
            android:id="@+id/tv_volume_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="静音"
            android:textSize="20sp"
            android:textColor="#7F8C8D" />

    </LinearLayout>

    <!-- 历史统计区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_max_volume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="最高: --"
            android:textSize="14sp"
            android:textColor="#E74C3C"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_min_volume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="最低: --"
            android:textSize="14sp"
            android:textColor="#3498DB"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_avg_volume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="平均: --"
            android:textSize="14sp"
            android:textColor="#F1C40F"
            android:gravity="center" />

    </LinearLayout>

    <!-- 底部控制区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="40dp">

        <!-- 重置按钮 -->
        <Button
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="重置统计"
            android:textSize="16sp"
            android:onClick="onResetClick"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

</LinearLayout>