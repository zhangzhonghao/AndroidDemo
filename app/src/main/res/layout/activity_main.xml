<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 类型1: 定位 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="定位"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_background">

            <Button
                android:id="@+id/btn_location_gps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="定位"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_location_geofence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="电子围栏"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_location_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="距离判断"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_location_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="静态地图"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_location_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="导航"
                android:onClick="onFeatureClick" />
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.2"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- 类型2: AI -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_background">

            <Button
                android:id="@+id/btn_ai_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI对话API版"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_ai_voice_sdk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI对话SDK版"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_ai_pet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="电子宠物"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_ai_image_gen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI 图片生成"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_ai_tts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="语音合成"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_ai_vision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="图片识别"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_ai_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI 写代码"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_ai_smart_qa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="智能问答"
                android:onClick="onFeatureClick" />
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.2"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- 类型3: UI -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UI"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_background">

            <Button
                android:id="@+id/btn_ui_bottom_nav_foldable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="底部菜单折叠屏适配"
                android:onClick="onFeatureClick" />
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.2"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- 类型4: 7个分类入口（替代原来的工具箱） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="工具"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_background">

            <Button
                android:id="@+id/btn_life_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="生活服务"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_health"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="健康"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_game"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="游戏"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_sensor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="传感器"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_efficiency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="效率"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_finance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="财务"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="工具"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_basic_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="基础工具"
                android:onClick="onFeatureClick" />
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.2"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- 类型5: 埋点（应用埋点改名） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="埋点"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_background">

            <Button
                android:id="@+id/btn_trace_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自定义埋点"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_trace_crash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crash埋点"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_trace_white_screen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="白屏埋点"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_trace_lag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="卡顿埋点"
                android:onClick="onFeatureClick" />

            <Button
                android:id="@+id/btn_trace_performance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="性能埋点"
                android:onClick="onFeatureClick" />
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.2"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- 类型6: 安全中心 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="安全中心"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_background">

            <Button
                android:id="@+id/btn_security_center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="安全中心"
                android:onClick="onFeatureClick" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
