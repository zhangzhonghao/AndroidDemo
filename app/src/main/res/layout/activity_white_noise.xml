<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="白噪音"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/btn_timer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_timer"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="定时关闭" />

    </LinearLayout>

    <!-- 计时器显示 -->
    <TextView
        android:id="@+id/tv_remaining_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        android:paddingTop="16dp"
        android:paddingBottom="16dp" />

    <!-- 播放状态 -->
    <TextView
        android:id="@+id/tv_playing_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点击音效开始播放"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- 音效网格 -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true">

        <!-- 雨声 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/icon_rain"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_rain"
                    android:contentDescription="雨声" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="雨声"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <SeekBar
                    android:id="@+id/seekbar_rain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_rain_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击播放"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 海浪 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/icon_wave"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_wave"
                    android:contentDescription="海浪" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="海浪"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <SeekBar
                    android:id="@+id/seekbar_wave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_wave_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击播放"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 森林 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/icon_forest"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_forest"
                    android:contentDescription="森林" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="森林"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <SeekBar
                    android:id="@+id/seekbar_forest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_forest_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击播放"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 篝火 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/icon_fire"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_fire"
                    android:contentDescription="篝火" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="篝火"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <SeekBar
                    android:id="@+id/seekbar_fire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_fire_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击播放"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 风声 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/icon_wind"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_wind"
                    android:contentDescription="风声" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="风声"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <SeekBar
                    android:id="@+id/seekbar_wind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_wind_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击播放"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 瀑布 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/icon_waterfall"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_waterfall"
                    android:contentDescription="瀑布" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="瀑布"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <SeekBar
                    android:id="@+id/seekbar_waterfall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_waterfall_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击播放"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 空调 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/icon_aircon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_aircon"
                    android:contentDescription="空调" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="空调"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <SeekBar
                    android:id="@+id/seekbar_aircon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_aircon_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击播放"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 交通 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/icon_traffic"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_traffic"
                    android:contentDescription="交通" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="交通"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <SeekBar
                    android:id="@+id/seekbar_traffic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_traffic_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击播放"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </GridLayout>

    <!-- 总音量控制 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="总音量"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seekbar_master"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="80"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- 底部控制按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btn_stop_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="停止全部"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Button
            android:id="@+id/btn_cancel_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消定时"
            android:visibility="gone"
            android:layout_marginStart="16dp" />

    </LinearLayout>

</LinearLayout>