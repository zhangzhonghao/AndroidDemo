<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="输入重量值"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/et_input"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_edit_text"
            android:gravity="center"
            android:hint="请输入重量值"
            android:inputType="numberDecimal|numberSigned"
            android:textSize="18sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择输入单位"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_from_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_kilogram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="千克 (kg)"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_gram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="克 (g)" />

            <RadioButton
                android:id="@+id/rb_milligram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="毫克 (mg)" />

            <RadioButton
                android:id="@+id/rb_pound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="磅 (lb)" />

            <RadioButton
                android:id="@+id/rb_ounce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="盎司 (oz)" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="换算结果"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_edit_text"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="千克 (kg)"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/tv_kilogram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- kg"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="克 (g)"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/tv_gram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- g"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="毫克 (mg)"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/tv_milligram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- mg"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="磅 (lb)"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/tv_pound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- lb"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="盎司 (oz)"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/tv_ounce"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- oz"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>