<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <!-- 输入区域 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输入数字"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_input"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_edit_text"
                android:hint="输入数字"
                android:inputType="text"
                android:textSize="24sp"
                android:textColor="@color/on_surface"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:autofillHints="none" />

            <!-- 进制选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择输入进制"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BIN (2)"
                    style="@style/Widget.Material3.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_oct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OCT (8)"
                    style="@style/Widget.Material3.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_dec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEC (10)"
                    android:checked="true"
                    style="@style/Widget.Material3.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEX (16)"
                    style="@style/Widget.Material3.Chip.Filter" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 转换结果区域 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="转换结果"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="16dp" />

            <!-- 二进制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="BIN (2)"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tv_bin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="20sp"
                    android:textColor="@color/secondary"
                    android:fontFamily="monospace"
                    android:gravity="end" />

                <ImageButton
                    android:id="@+id/btn_copy_bin"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_save"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="复制"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- 八进制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="OCT (8)"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tv_oct"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="20sp"
                    android:textColor="@color/secondary"
                    android:fontFamily="monospace"
                    android:gravity="end" />

                <ImageButton
                    android:id="@+id/btn_copy_oct"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_save"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="复制"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- 十进制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="DEC (10)"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tv_dec"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="20sp"
                    android:textColor="@color/secondary"
                    android:fontFamily="monospace"
                    android:gravity="end" />

                <ImageButton
                    android:id="@+id/btn_copy_dec"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_save"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="复制"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- 十六进制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="HEX (16)"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tv_hex"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="20sp"
                    android:textColor="@color/secondary"
                    android:fontFamily="monospace"
                    android:gravity="end" />

                <ImageButton
                    android:id="@+id/btn_copy_hex"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_save"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="复制"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 清除按钮 -->
    <Button
        android:id="@+id/btn_clear"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="清除"
        android:textSize="16sp" />

</LinearLayout>