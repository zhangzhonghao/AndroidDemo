<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:gravity="center_horizontal">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="请绘制解锁图案"
        android:textSize="20sp"
        android:textColor="@color/on_surface"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="16dp" />

    <!-- 状态提示 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="@color/on_surface_variant"
        android:layout_marginBottom="32dp" />

    <!-- 九宫格图案视图 -->
    <com.example.androiddemo.tools.PatternLockView
        android:id="@+id/pattern_lock_view"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center" />

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:text="确认"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="重置"
            android:textSize="16sp"
            android:visibility="gone"
            style="@style/Widget.AndroidDemo.Button.Outlined" />

        <Button
            android:id="@+id/btn_toggle_mode"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="切换为设置模式"
            android:textSize="16sp"
            style="@style/Widget.AndroidDemo.Button.Text" />

    </LinearLayout>

</LinearLayout>